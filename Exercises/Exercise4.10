cubes=[]

for i in range(1,11):
    cubes.append(i**3)

print("Tiga angka pertama di list adalah:")
for cube in cubes[:3]:
    print(cube)

print("Tiga item dari tengah list adalah:")
for cube in cubes[4:7]:
    print(cube)

print("Tiga item terakhir di list adalah:")
for cube in cubes[-3:]:
    print(cube)