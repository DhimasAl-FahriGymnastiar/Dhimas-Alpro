#Conditional
topping = ""

while topping != 'quit':
    topping = input("Enter a topping (or 'quit'): ")

    if topping != 'quit':
        print(f"I'll add {topping} to your pizza.")
        
#Active variable
active = True

while active:
    topping = input("Enter a topping (or 'quit'): ")

    if topping == 'quit':
        active = False
    else:
        print(f"I'll add {topping} to your pizza.")
        
#Break statement
while True:
    topping = input("Enter a topping (or 'quit'): ")

    if topping == 'quit':
        break

    print(f"I'll add {topping} to your pizza.")