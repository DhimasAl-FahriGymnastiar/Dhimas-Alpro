#Program 1
def display_message():
    print("I am learning Python functions.")


display_message()

#Program 2
def city_country(city, country):
    return f"{city.title()}, {country.title()}"


print(city_country("surakarta", "indonesia"))
print(city_country("tokyo", "japan"))

#Program 3
def make_sandwich(*items):
    print("\nMaking a sandwich with:")

    for item in items:
        print(f"- {item}")


make_sandwich("cheese")
make_sandwich("chicken", "lettuce")
make_sandwich("beef", "tomato", "onion")