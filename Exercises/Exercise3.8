tempat=['Paris', 'Tokyo', 'New York', 'London', 'Sydney']
print(tempat)

#Mengurutkan tempat
print(sorted(tempat))

#Mengecek list asli
print(tempat)

#Mengurutkan tempat secara terbalik
print(sorted(tempat, reverse=True))
print(tempat)

#Mengecek list asli
print(tempat)

#Membalik urutan list
tempat.reverse()
print(tempat)

#Mengembalikan urutan list ke semula
tempat.reverse()
print(tempat)

#Mengurutkan list secara permanen
tempat.sort()
print(tempat)

#Mengurutkan list secara permanen secara terbalik
tempat.sort(reverse=True)
print(tempat)