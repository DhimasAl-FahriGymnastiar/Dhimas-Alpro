my_food=['Pizza','Burger','Pasta','Sushi','Salad']

friend_food=my_food[:]

my_food.append('Ice Cream')
friend_food.append('Fries')

print("My favorite foods are:")
for food in my_food:
    print(food)
    
print("\nMy friend's favorite foods are:")
for friend_food in friend_food:
    print(friend_food)