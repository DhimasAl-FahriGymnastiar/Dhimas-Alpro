motor=['Honda', 'Yamaha', 'Suzuki', 'Ducati','Kawasaki']

#Memberikan output motor Honda
print(motor[0])

#Memasukkan motor baru di index 0
motor.insert(0,'Harley Davidson')
print(motor)

#Memasukkan motor baru
motor.append('Triumph')
print(motor)

#Menghapus motor menggunakan del
del motor[1]
print(motor)

#Menghapus motor menggunakan pop
pop_motor = motor.pop(2)
print(f'Motor yang dihapus adalah {pop_motor}')
print(motor)

#Menghapus motor menggunakan remove
motor.remove('Ducati')
print(motor)

#Mengurutkan motor secara alpabet
print(sorted(motor))

#Mengurutkan motor secara terbalik
print(sorted(motor, reverse=True))

#Membalik urutan motor
motor.reverse()
print(motor)

#Mengurutkan motor secara permanen
motor.sort()
print(motor)

#Mengurutkan motor secara permanen secara terbalik
motor.sort(reverse=True)
print(motor)

#Menghitung jumlah motor
print(f'Jumlah motor yang ada adalah {len(motor)}')